# Docker Compose project and host binding. Keep 127.0.0.1 when host Caddy
# reverse-proxies to this service.
COMPOSE_PROJECT_NAME=openlabstock
OPENLABSTOCK_BIND_IP=127.0.0.1
OPENLABSTOCK_PORT=4388
OPENLABSTOCK_IMAGE_TAG=latest
# init/update 会从 package.json 自动刷新该值，用于镜像版本标签。
OPENLABSTOCK_IMAGE_VERSION=local

# HTTPS behind Caddy. For deliberate direct HTTP/IP access, use
# OPENLABSTOCK_BIND_IP=0.0.0.0 and COOKIE_SECURE=0; credentials are then plaintext
# on the network.
TRUST_PROXY=1
COOKIE_SECURE=1

SESSION_MAX_AGE_DAYS=15
SQLITE_BUSY_TIMEOUT_MS=10000
DATABASE_UPLOAD_MAX_BYTES=104857600
BACKUP_RETENTION_DAYS=30

# Conservative limits for a 2-core, 2-GB host that also runs Caddy and another
# small website.
OPENLABSTOCK_MEMORY_LIMIT=512m
OPENLABSTOCK_CPU_LIMIT=1.0

# Used only while creating a brand-new database. deploy/docker/openlabstock.sh init
# generates it automatically and clears this value after initialization.
INITIAL_ADMIN_PASSWORD=
