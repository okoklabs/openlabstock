{
  "name": "openlabstock",
  "version": "2026.8.14-r41",
  "description": "Self-hosted laboratory consumables inventory, stocktake, and audit system",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okoklabs/openlabstock.git"
  },
  "homepage": "https://github.com/okoklabs/openlabstock#readme",
  "bugs": {
    "url": "https://github.com/okoklabs/openlabstock/issues"
  },
  "keywords": [
    "inventory",
    "laboratory",
    "consumables",
    "stocktake",
    "sqlite",
    "self-hosted"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "backup": "node scripts/backup.mjs",
    "benchmark:capacity": "node scripts/benchmark-capacity.mjs",
    "release": "node scripts/release.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "astro check",
    "dev": "pnpm run build && pnpm run start",
    "build": "astro build",
    "preview": "pnpm run start",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "pnpm run build && playwright test",
    "verify:quick": "pnpm run check:docs && pnpm run check:licenses && pnpm run check && pnpm test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.2",
    "@zxing/browser": "^0.2.1",
    "astro": "7.1.6",
    "lucide-react": "1.28.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "5.9.3"
  }
}
