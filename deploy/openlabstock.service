[Unit]
Description=OpenLabStock consumables inventory
After=network.target

[Service]
Type=simple
User=openlabstock
Group=openlabstock
WorkingDirectory=/opt/openlabstock
EnvironmentFile=/etc/openlabstock/openlabstock.env
ExecStart=/usr/bin/node /opt/openlabstock/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/openlabstock
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
