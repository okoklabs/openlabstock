NODE_ENV=production
HOST=127.0.0.1
PORT=4388
DATA_DIR=/var/lib/openlabstock
BACKUP_DIR=/var/lib/openlabstock/backups
# Stable, non-secret identifier used by a private instance-management control plane.
INSTANCE_ID=example-lab-prod
TRUST_PROXY=1
COOKIE_SECURE=1
SESSION_MAX_AGE_DAYS=15
SQLITE_BUSY_TIMEOUT_MS=10000
DATABASE_UPLOAD_MAX_BYTES=104857600
# Optional shared secret for private control-plane database diagnostics.
HEALTH_DETAIL_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OR_LEAVE_EMPTY
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_8_TO_128_CHARACTER_PASSWORD
