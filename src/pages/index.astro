---
import {
  AlertTriangle,
  Archive,
  ArrowDownToLine,
  ArrowUpFromLine,
  Bell,
  Building2,
  Boxes,
  Check,
  ChevronLeft,
  ChevronRight,
  ClipboardCheck,
  ClipboardList,
  Download,
  FileSpreadsheet,
  History,
  Camera,
  Info,
  ImageDown,
  ImageUp,
  LayoutDashboard,
  LogOut,
  Menu,
  MoreVertical,
  Package,
  Pencil,
  Plus,
  Printer,
  QrCode,
  RotateCcw,
  RotateCcwKey,
  Search,
  ScanLine,
  Settings,
  ShieldCheck,
  Star,
  Tags,
  KeyRound,
  Trash2,
  Upload,
  UserCheck,
  UserX,
  Users,
  X,
} from 'lucide-react';
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="description" content="OpenLabStock 实验室耗材管理工作台" />
    <meta name="theme-color" content="#006b55" />
    <meta name="color-scheme" content="light" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="耗材管理" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/labstock-180-v1.png" />
    <title>OpenLabStock · 实验室耗材管理</title>
    <style is:global>
      :root {
        --bg: #f7faf8;
        --surface: #ffffff;
        --surface-soft: #eef3f0;
        --surface-tint: #e3eee9;
        --surface-container: #e9efec;
        --ink: #18201c;
        --muted: #52615a;
        --line: #c4cec8;
        --primary: #006b55;
        --primary-deep: #004b3b;
        --primary-soft: #c9ecdf;
        --warning: #9a6200;
        --warning-soft: #fff0c9;
        --danger: #b32d30;
        --danger-soft: #fde5e2;
        --info: #476b9f;
        --info-soft: #e4edfb;
        --shadow-1: 0 1px 2px rgba(23, 33, 29, .12);
        --shadow-2: 0 8px 24px rgba(23, 33, 29, .14);
        --radius: 8px;
        font-family: Inter, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
        color: var(--ink);
        background: var(--bg);
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body { margin: 0; background: var(--bg); color: var(--ink); -webkit-font-smoothing: antialiased; }
      body.modal-open { overflow: hidden; }
      datalist { display: none !important; }
      button, input, select, textarea { font: inherit; }
      button { cursor: pointer; }
      a { color: inherit; text-decoration: none; }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
      .app-shell { min-height: 100vh; display: flex; }
      .sidebar { width: 256px; flex: 0 0 256px; border-right: 1px solid #e0e6e2; background: #fbfdfb; display: flex; flex-direction: column; padding: 20px 12px 14px; }
      .brand { display: flex; align-items: center; gap: 11px; padding: 0 10px 25px; }
      .brand > span:last-child, .login-brand > span:last-child { min-width: 0; flex: 1; }
      .brand-mark { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 12px; color: white; background: var(--primary); box-shadow: 0 2px 5px rgba(0,75,59,.18); }
      .brand-mark img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
      .brand-name { font-size: 18px; font-weight: 740; letter-spacing: 0; }
      .brand-sub { display: block; max-width: 100%; overflow: hidden; color: var(--muted); font-size: 12px; font-weight: 500; margin-top: 1px; text-overflow: ellipsis; white-space: nowrap; }
      .workspace-switcher { min-height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 14px; border: 0; border-radius: 28px; background: var(--surface-soft); margin-bottom: 24px; color: var(--ink); }
      .workspace-switcher > span { min-width: 0; display: flex; align-items: center; gap: 0; font-size: 13px; font-weight: 650; }
      .workspace-name { min-width: 0; display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-height: 1.35; overflow-wrap: anywhere; }
      .workspace-dot { display: none; }
      .nav-label { color: var(--muted); font-size: 12px; font-weight: 650; letter-spacing: 0; padding: 0 16px 8px; }
      .nav { display: grid; gap: 3px; }
      .nav-item { width: 100%; display: flex; align-items: center; gap: 13px; min-height: 48px; padding: 0 16px; border: 0; border-radius: 24px; background: transparent; color: var(--muted); text-align: left; font-size: 14px; font-weight: 600; }
      .nav-item svg { color: #7d8b83; }
      .nav-item:hover { color: var(--ink); }
      .nav-item.active { color: #00382c; background: var(--primary-soft); font-weight: 700; }
      .nav-item.active svg { color: var(--primary); }
      .nav-badge { margin-left: auto; min-width: 20px; padding: 2px 6px; border-radius: 10px; background: var(--warning-soft); color: var(--warning); font-size: 10px; text-align: center; }
      .sidebar-spacer { flex: 1; }
      .sidebar-note { margin: 10px 7px 16px; padding: 11px 12px; border-left: 3px solid var(--primary); background: var(--surface-tint); border-radius: 0 6px 6px 0; }
      .sidebar-note strong { display: block; font-size: 11px; margin-bottom: 4px; }
      .sidebar-note span { display: block; color: var(--muted); font-size: 11px; line-height: 1.5; }
      .sidebar-version { padding: 0 10px 8px; color: var(--muted); font-size: 10px; }
      .sidebar-version span { font-variant-numeric: tabular-nums; }
      .user-card { display: flex; align-items: center; gap: 10px; padding: 11px 9px 3px; border-top: 1px solid var(--line); }
      .avatar { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; color: var(--primary-deep); background: var(--primary-soft); font-size: 12px; font-weight: 760; }
      .account-avatar { padding: 0; border: 0; transition: background-color .16s ease, box-shadow .16s ease; }
      .account-avatar:hover, .account-avatar:focus-visible { background: #b8e3d3; box-shadow: 0 0 0 3px rgba(18,107,89,.11); }
      .user-meta { min-width: 0; flex: 1; }
      .user-meta strong { display: block; font-size: 12px; }
      .user-meta span { display: block; color: var(--muted); font-size: 10px; margin-top: 2px; }
      .icon-button { width: 40px; height: 40px; display: grid; place-items: center; padding: 0; border: 1px solid transparent; border-radius: 50%; color: var(--muted); background: transparent; }
      .icon-button:hover { color: var(--ink); }
      .main { min-width: 0; flex: 1; }
      .topbar { height: 72px; display: flex; align-items: center; gap: 18px; padding: 0 32px; border-bottom: 1px solid #e1e7e3; background: rgba(251,253,251,.94); }
      .mobile-menu { display: none; color: var(--ink); }
      .mobile-menu:active { transform: scale(.96); }
      .mobile-menu[aria-expanded="true"] { color: var(--primary); }
      .mobile-menu[aria-expanded="true"]::before { opacity: .12; transform: scale(1); }
      .search { width: min(420px, 42vw); position: relative; }
      .search svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #8a968f; }
      .search input { width: 100%; height: 46px; padding: 0 16px 0 43px; border: 1px solid transparent; border-radius: 23px; color: var(--ink); background: var(--surface-soft); outline: none; font-size: 13px; }
      .search input:focus { border-color: var(--primary); background: var(--surface); box-shadow: 0 0 0 3px rgba(18,107,89,.12); }
      .topbar-spacer { flex: 1; }
      .topbar-link { color: var(--muted); font-size: 12px; font-weight: 650; }
      .topbar-link:hover { color: var(--primary); }
      .notification { position: relative; }
      .notification-dot { position: absolute; top: 5px; right: 5px; width: 6px; height: 6px; border: 2px solid white; border-radius: 50%; background: var(--danger); }
      .content { max-width: 1360px; margin: 0 auto; padding: 34px 32px 60px; }
      .view { display: none; }
      .view.active { display: block; animation: fade-in .2s ease-out; }
      @keyframes fade-in { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: translateY(0); } }
      .page-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 25px; }
      .page-heading h1 { margin: 0; font-size: 30px; font-weight: 700; letter-spacing: 0; line-height: 1.2; }
      .page-heading p { margin: 8px 0 0; color: var(--muted); font-size: 13px; }
      .heading-actions { display: flex; gap: 9px; }
      .heading-actions > .button { min-width: 0; }
      .action-label-mobile { display: none; }
      .inventory-heading-actions > [data-open-modal] { min-width: 0; line-height: 1.25; text-align: center; }
      .inventory-overflow { position: relative; display: block; }
      .inventory-command-scrim { position: fixed; inset: 0; z-index: 28; display: none; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; }
      .inventory-command-menu { position: absolute; top: calc(100% + 8px); right: 0; z-index: 29; width: 238px; padding: 6px 0; border: 1px solid #dce4df; border-radius: 8px; visibility: hidden; opacity: 0; background: var(--surface); box-shadow: var(--shadow-2); pointer-events: none; transform: translateY(-5px) scale(.98); transform-origin: top right; transition: opacity .16s ease, transform .2s cubic-bezier(.2, 0, 0, 1), visibility 0s linear .2s; }
      .inventory-overflow.open .inventory-command-scrim { display: block; }
      .inventory-overflow.open .inventory-command-menu { visibility: visible; opacity: 1; pointer-events: auto; transform: translateY(0) scale(1); transition-delay: 0s; }
      .inventory-command-item { width: 100%; min-height: 48px; display: flex; align-items: center; gap: 13px; padding: 0 16px; border: 0; border-radius: 0; color: var(--ink); background: transparent; font-size: 14px; font-weight: 600; text-align: left; white-space: nowrap; }
      .inventory-command-item svg { flex: 0 0 auto; color: var(--muted); }
      .inventory-command-item:focus-visible { outline: 2px solid var(--primary); outline-offset: -3px; }
      .inventory-command-divider { height: 1px; margin: 6px 0; background: var(--line); }
      .inventory-action-proxies, .inventory-toolbar-actions { display: none !important; }
      .button { min-height: 40px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 18px; border: 1px solid var(--line); border-radius: 20px; color: var(--primary-deep); background: transparent; font-size: 13px; font-weight: 700; white-space: nowrap; }
      .button:hover { box-shadow: var(--shadow-1); }
      .button:active { transform: scale(.98); }
      .button:disabled, .icon-button:disabled { cursor: not-allowed; opacity: .42; box-shadow: none; }
      .button.primary { border-color: var(--primary); color: white; background: var(--primary); box-shadow: 0 1px 2px rgba(0,75,59,.25); }
      .button.primary:hover { background: var(--primary); }
      .button.tonal { border-color: transparent; color: #17352d; background: var(--primary-soft); }
      .button.tonal:hover { background: var(--primary-soft); }
      .button.ghost { border-color: transparent; background: transparent; color: var(--muted); }
      .button.danger { color: var(--danger); border-color: var(--danger-soft); background: var(--danger-soft); }
      .button.danger-filled { border-color: var(--danger); color: white; background: var(--danger); box-shadow: 0 1px 2px rgba(179,45,48,.22); }
      .button.danger-filled:hover { background: var(--danger); }
      .text-button { min-height: 40px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 0 12px; border: 0; border-radius: 20px; color: var(--primary); background: transparent; font-size: 14px; font-weight: 700; white-space: nowrap; }
      .text-button:disabled { cursor: not-allowed; opacity: .42; }
      :is(.button, .icon-button, .text-button, .material-info-trigger, .nav-item, .quick-action, .segment, .m3-select-trigger, .m3-select-option, .inventory-command-item, .stocktake-batch-row, .mobile-nav button) { position: relative; isolation: isolate; overflow: hidden; -webkit-tap-highlight-color: transparent; transition: color .18s ease, background-color .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s cubic-bezier(.2, 0, 0, 1); }
      :is(.button, .icon-button, .text-button, .material-info-trigger, .nav-item, .quick-action, .segment, .m3-select-trigger, .m3-select-option, .inventory-command-item, .stocktake-batch-row, .mobile-nav button)::before { position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: currentColor; content: ""; opacity: 0; transform: scale(.72); transition: opacity .18s ease, transform .24s cubic-bezier(.2, 0, 0, 1); }
      :is(.button, .icon-button, .text-button, .material-info-trigger, .nav-item, .quick-action, .segment, .m3-select-trigger, .m3-select-option, .inventory-command-item, .stocktake-batch-row, .mobile-nav button):not(:disabled):hover::before { opacity: .08; transform: scale(1); }
      :is(.button, .icon-button, .text-button, .material-info-trigger, .nav-item, .quick-action, .segment, .m3-select-trigger, .m3-select-option, .inventory-command-item, .stocktake-batch-row, .mobile-nav button):not(:disabled):focus-visible::before { opacity: .1; transform: scale(1); }
      :is(.button, .icon-button, .text-button, .material-info-trigger, .nav-item, .quick-action, .segment, .m3-select-trigger, .m3-select-option, .inventory-command-item, .stocktake-batch-row, .mobile-nav button):not(:disabled):active::before { opacity: .12; transform: scale(1); transition-duration: .06s; }
      .m3-ripple { position: absolute; z-index: 0; border-radius: 50%; background: currentColor; pointer-events: none; transform: scale(0); animation: m3-ripple .46s cubic-bezier(.2, 0, 0, 1) forwards; }
      @keyframes m3-ripple { 0% { opacity: .16; transform: scale(0); } 65% { opacity: .1; } 100% { opacity: 0; transform: scale(1); } }
      .summary-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 13px; margin-bottom: 25px; }
      .summary-card { min-height: 142px; padding: 20px; border: 1px solid #dce4df; border-radius: var(--radius); background: var(--surface); box-shadow: none; }
      .summary-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: var(--muted); font-size: 13px; font-weight: 600; }
      .summary-icon { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 18px; color: var(--primary); background: var(--primary-soft); }
      .summary-card:nth-child(2) .summary-icon { color: var(--danger); background: var(--danger-soft); }
      .summary-card:nth-child(3) .summary-icon { color: var(--primary); background: var(--primary-soft); }
      .summary-card:nth-child(4) .summary-icon { color: var(--info); background: var(--info-soft); }
      .summary-value { margin-top: 14px; font-size: 30px; font-weight: 700; letter-spacing: 0; }
      .summary-meta { display: flex; align-items: center; gap: 5px; margin-top: 8px; color: var(--muted); font-size: 11px; }
      .summary-meta.positive { color: var(--primary); }
      .summary-meta.warning { color: var(--warning); }
      .section-row { display: grid; grid-template-columns: minmax(0, 1.48fr) minmax(300px, .82fr); gap: 18px; align-items: stretch; margin-bottom: 18px; }
      .section-row > .panel { height: 100%; }
      .panel { border: 1px solid #dce4df; border-radius: var(--radius); background: var(--surface); box-shadow: none; overflow: hidden; }
      .panel-header { min-height: 70px; display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 0 20px; border-bottom: 1px solid #e6ebe8; }
      .panel-header h2 { margin: 0; font-size: 16px; font-weight: 700; letter-spacing: 0; }
      .panel-header p { margin: 5px 0 0; color: var(--muted); font-size: 12px; }
      .panel-header-actions { display: flex; align-items: center; gap: 2px; flex: 0 0 auto; }
      .panel-header .text-button { min-height: 36px; flex: 0 0 auto; padding: 0 12px; border: 0; border-radius: 18px; color: var(--primary); background: transparent; font-size: 12px; font-weight: 700; white-space: nowrap; }
      .panel-header .text-button:hover { background: transparent; }
      .stock-table, .transaction-table, .data-table { width: 100%; border-collapse: collapse; }
      .stock-table th, .stock-table td, .transaction-table th, .transaction-table td, .data-table th, .data-table td { height: 52px; padding: 10px 20px; border-bottom: 1px solid #edf1ee; text-align: left; font-size: 13px; vertical-align: middle; }
      .stock-table th, .transaction-table th, .data-table th { color: var(--muted); font-size: 11px; font-weight: 650; letter-spacing: 0; background: var(--surface-soft); }
      .stock-table tr:last-child td, .transaction-table tr:last-child td, .data-table tr:last-child td { border-bottom: 0; }
      .low-stock-panel .table-scroll { max-height: 286px; overflow: auto; scrollbar-color: #aab7b0 transparent; scrollbar-width: thin; }
      .low-stock-panel .stock-table thead { position: sticky; top: 0; z-index: 2; }
      .low-stock-panel .stock-table tbody tr { transition: background-color .18s ease; }
      .low-stock-panel .stock-table tbody tr:hover { background: color-mix(in srgb, var(--danger) 4%, var(--surface)); }
      .stock-item { display: flex; align-items: center; gap: 9px; min-width: 155px; }
      .material-info-trigger { width: 100%; padding: 0; border: 0; color: inherit; background: transparent; font: inherit; text-align: left; cursor: pointer; }
      .material-info-trigger:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
      .item-avatar { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 6px; color: var(--primary); background: var(--surface-tint); font-size: 11px; font-weight: 760; }
      .stock-item strong { display: block; color: var(--ink); font-size: 13px; }
      .stock-item > span:last-child > span { display: block; color: var(--muted); font-size: 11px; margin-top: 2px; }
      .stock-number { font-weight: 750; }
      .stock-low { color: var(--danger); }
      .stock-mid { color: var(--warning); }
      .progress { width: 90px; height: 5px; overflow: hidden; border-radius: 3px; background: #e9eeeb; }
      .progress > span { display: block; height: 100%; border-radius: inherit; background: var(--primary); }
      .progress > span.mid { background: #d69222; }
      .progress > span.low { background: var(--danger); }
      .quick-panel { padding-bottom: 4px; }
      .quick-list { display: grid; gap: 8px; padding: 15px 16px; }
      .quick-action { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 62px; padding: 8px 12px; border: 0; border-radius: 8px; background: var(--surface-soft); text-align: left; }
      .quick-action:hover { background: var(--surface-soft); }
      .quick-action-icon { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 18px; color: var(--primary); background: var(--primary-soft); }
      .quick-action.out .quick-action-icon { color: var(--info); background: var(--info-soft); }
      .quick-action.import .quick-action-icon { color: var(--warning); background: var(--warning-soft); }
      .quick-action.records .quick-action-icon { color: #6b4e16; background: #fff0c7; }
      .quick-action strong { display: block; font-size: 13px; }
      .quick-action > span:not(.quick-action-icon) { display: block; color: var(--muted); font-size: 11px; margin-top: 0; }
      .quick-action-icon svg { display: block; margin: 0; }
      .quick-action > svg { margin-left: auto; color: #a1aca5; }
      .notice { display: flex; align-items: flex-start; gap: 9px; margin: 0 16px 15px; padding: 10px 11px; color: var(--warning); background: var(--warning-soft); border-radius: 6px; font-size: 10px; line-height: 1.5; }
      .notice svg { flex: 0 0 auto; margin-top: 1px; }
      .chart { height: 218px; padding: 18px 18px 10px; }
      .chart-legend { display: flex; gap: 17px; margin-bottom: 13px; color: var(--muted); font-size: 10px; }
      .legend-dot { width: 7px; height: 7px; display: inline-block; margin-right: 5px; border-radius: 50%; background: var(--primary); }
      .legend-dot.out { background: #90a8ca; }
      .bars { height: 154px; display: grid; grid-template-columns: repeat(6, minmax(0,1fr)); gap: 15px; align-items: end; padding: 0 7px; border-bottom: 1px solid var(--line); }
      .bar-group { height: 100%; display: flex; align-items: end; justify-content: center; gap: 4px; position: relative; }
      .bar { width: 11px; min-height: 4px; border-radius: 3px 3px 0 0; background: var(--primary); }
      .bar.out { background: #90a8ca; }
      .bar.zero { opacity: .22; }
      .bar-label { position: absolute; bottom: -21px; color: var(--muted); font-size: 10px; }
      .table-scroll { overflow-x: auto; }
      .type-chip { display: inline-flex; align-items: center; gap: 4px; padding: 5px 9px; border-radius: 12px; font-size: 11px; font-weight: 700; white-space: nowrap; }
      .type-chip.in { color: var(--primary-deep); background: var(--primary-soft); }
      .type-chip.out { color: #3f5d87; background: var(--info-soft); }
      .type-chip.adjustment { color: #674000; background: var(--warning-soft); }
      .record-note-content { width: 100%; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
      .record-note-copy { min-width: 0; overflow-wrap: anywhere; }
      .record-inline-action { flex: 0 0 auto; }
      .record-inline-action svg { width: 16px; height: 16px; }
      .record-correction-state { flex: 0 0 auto; color: var(--muted); font-size: 12px; font-weight: 650; white-space: nowrap; }
      .status-chip { min-width: 0; max-width: 100%; display: inline-flex; align-items: center; overflow: hidden; padding: 5px 9px; border-radius: 12px; font-size: 11px; font-weight: 700; line-height: 18px; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; }
      .status-chip.ok { color: var(--primary-deep); background: var(--primary-soft); }
      .status-chip.low { color: var(--danger); background: var(--danger-soft); }
      .status-chip.warning { color: #805500; background: var(--warning-soft); }
      .status-chip.archived { color: var(--muted); background: var(--surface-container); }
      .role-chip.owner { color: #704d00; background: var(--warning-soft); }
      .role-chip.admin { color: #31537f; background: var(--info-soft); }
      .role-chip.inventory { color: var(--primary-deep); background: var(--primary-soft); }
      .role-chip.member { color: var(--muted); background: var(--surface-container); }
      .user-cell { display: flex; align-items: center; gap: 8px; }
      .mini-avatar { width: 23px; height: 23px; display: grid; place-items: center; border-radius: 50%; color: var(--primary-deep); background: var(--surface-tint); font-size: 9px; font-weight: 750; }
      .member-actions { width: 52px; text-align: right !important; }
